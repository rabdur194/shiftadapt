# Optional: set your OpenAI key for real LLM generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Use mock LLM when no key is available (default true)
USE_MOCK_LLM=true

# Shift detection threshold (cosine distance)
SHIFT_THRESHOLD=0.25

# Embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

TOP_K=3
